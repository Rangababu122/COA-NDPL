<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Left Track Line & Station Node -->
    <LinearLayout
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:id="@+id/lineTop"
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="#334155" />

        <View
            android:id="@+id/stationDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@android:drawable/presence_online" />

        <View
            android:id="@+id/lineBottom"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#334155" />
    </LinearLayout>

    <!-- Right Station Card -->
    <LinearLayout
        android:id="@+id/cardStation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:background="#1A1E26"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStationCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DHNE"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClearTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="— Clear / No Train —"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Container for Trains at this Station -->
        <LinearLayout
            android:id="@+id/trainsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

    </LinearLayout>
</LinearLayout>
